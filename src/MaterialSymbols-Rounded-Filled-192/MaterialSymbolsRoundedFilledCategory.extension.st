Extension { #name : 'MaterialSymbolsRoundedFilledCategory' }

{ #category : '*MaterialSymbols-Rounded-Filled-192' }
MaterialSymbolsRoundedFilledCategory class >> masterDescription [
	"Where the PNGs of master_<name> come from: rasterized at 192 pixels from the optical size 48,
	the largest, FILL 1, wght 400, GRAD 0"

	^ 'https://github.com/google/material-design-icons at commit 10ecc14790612ca8fd164e3f4ffe9c16fc50d5b7, symbols/web/{name}/materialsymbolsrounded/{name}_fill1_48px.svg'
]

{ #category : '*MaterialSymbols-Rounded-Filled-192' }
MaterialSymbolsRoundedFilledCategory class >> masterSize [
	"The side in pixels of the PNGs of master_<name>"

	^ 192
]
