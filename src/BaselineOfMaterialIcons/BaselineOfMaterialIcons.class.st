"
I load Material Icons Rounded and Material Symbols Rounded (fonts.google.com/icons) into Pharo 12 to 15:

- group `Core`: `MaterialIcons-Core` and `MaterialIcons-Rounded`, `MaterialIcons rounded`, the 2127 icons of Material Icons Rounded by their Material names, as Forms and FormSets at 16, 24 and 32 pixels, in any colour, with their categories, codepoints and tags;
- group `IconsRounded`: `Core` and `MaterialIcons-Rounded-192`, the 192-pixel master of each icon (Google's own PNGs), so that `formNamed:size:` draws any size from it;
- group `SymbolsRounded`: `MaterialIcons-Core`, `MaterialSymbols-Rounded` and `MaterialSymbols-Rounded-192`, `MaterialIcons symbolsRounded`, the 3944 icons of Material Symbols Rounded (FILL 0, wght 400, GRAD 0) at 16, 24 and 32 pixels and their masters at 192; `SymbolsRoundedSmall` without the masters;
- group `SymbolsRoundedFilled` (not in `default`): `MaterialSymbols-Rounded-Filled` and `MaterialSymbols-Rounded-Filled-192`, `MaterialIcons symbolsRoundedFilled`, the same icons filled (FILL 1);
- group `ThemePack`: `MaterialIcons-ThemePack`, `MaterialThemeIcons`, an icon pack of Pharo's UI drawn with Material Icons Rounded, over the current pack;
- group `SymbolsThemePack`: `MaterialSymbols-ThemePack`, `MaterialSymbolsThemeIcons`, the same with Material Symbols Rounded;
- group `SymbolsProtocols`: `SymbolsRoundedSmall`, `MaterialSymbols-Protocols` and `MaterialSymbols-Protocols-Calypso`, `MaterialProtocolSymbols`, a Material Symbol for the common method protocols (accessing, testing, initialization, printing...), shown by the browsers of Calypso; `SymbolsProtocolsTests`: `MaterialSymbols-Protocols-Tests`;
- group `Tests`: `MaterialIcons-Tests` and `MaterialSymbols-Tests` (`IconsTests` and `SymbolsTests` for one set);
- group `default`: `SymbolsRoundedSmall`, `SymbolsThemePack`, `SymbolsProtocols`, `SymbolsTests` and `SymbolsProtocolsTests`, the symbols only and without their masters (their tests skip themselves); group `Full`: all of them.

The data packages are generated by scripts/generate.py. Loading changes no icon of the UI: `MaterialThemeIcons install` or `MaterialSymbolsThemeIcons install` does. `SymbolsProtocols` adds icons next to the protocols in the browsers (`MaterialProtocolSymbols enabled: false`, or Settings > Appearance, turns them off).

```
Metacello new
	baseline: 'MaterialIcons';
	repository: 'github://massimo-nocentini/material-icons.st:master/src';
	load
```

`repository: 'tonel:///path/to/material-icons.st/src'` loads a local clone. `load: 'Core'` loads Material Icons Rounded alone at the small sizes, `load: #( 'IconsRounded' 'ThemePack' 'IconsTests' )` Material Icons Rounded with its masters, its pack and its tests.
"
Class {
	#name : 'BaselineOfMaterialIcons',
	#superclass : 'BaselineOf',
	#category : 'BaselineOfMaterialIcons',
	#package : 'BaselineOfMaterialIcons'
}

{ #category : 'baselines' }
BaselineOfMaterialIcons >> baseline: spec [

	<baseline>
	spec for: #common do: [
		spec
			package: 'MaterialIcons-Core';
			package: 'MaterialIcons-Rounded' with: [
				spec
					requires: #( 'MaterialIcons-Core' );
					postLoadDoIt: #materialIconsPostLoad ];
			package: 'MaterialIcons-Rounded-192' with: [
				spec
					requires: #( 'MaterialIcons-Rounded' );
					postLoadDoIt: #materialIconsPostLoad ];
			package: 'MaterialSymbols-Rounded' with: [
				spec
					requires: #( 'MaterialIcons-Core' );
					postLoadDoIt: #materialIconsPostLoad ];
			package: 'MaterialSymbols-Rounded-192' with: [
				spec
					requires: #( 'MaterialSymbols-Rounded' );
					postLoadDoIt: #materialIconsPostLoad ];
			package: 'MaterialSymbols-Rounded-Filled' with: [
				spec
					requires: #( 'MaterialSymbols-Rounded' );
					postLoadDoIt: #materialIconsPostLoad ];
			package: 'MaterialSymbols-Rounded-Filled-192' with: [
				spec
					requires: #( 'MaterialSymbols-Rounded-Filled' );
					postLoadDoIt: #materialIconsPostLoad ];
			package: 'MaterialIcons-ThemePack'
			with: [ spec requires: #( 'MaterialIcons-Rounded' ) ];
			package: 'MaterialSymbols-ThemePack'
			with: [ spec requires: #( 'MaterialSymbols-Rounded' ) ];
			package: 'MaterialIcons-Tests' with: [
				spec requires: #( 'MaterialIcons-ThemePack' 'MaterialIcons-Rounded-192' ) ];
			package: 'MaterialSymbols-Tests' with: [
				spec requires: #( 'MaterialSymbols-ThemePack' ) ];
			package: 'MaterialSymbols-Protocols'
			with: [ spec requires: #( 'MaterialSymbols-Rounded' ) ];
			package: 'MaterialSymbols-Protocols-Calypso'
			with: [ spec requires: #( 'MaterialSymbols-Protocols' ) ];
			package: 'MaterialSymbols-Protocols-Tests'
			with: [ spec requires: #( 'MaterialSymbols-Protocols-Calypso' ) ].
		spec
			group: 'Core' with: #( 'MaterialIcons-Core' 'MaterialIcons-Rounded' );
			group: 'IconsRounded' with: #( 'Core' 'MaterialIcons-Rounded-192' );
			group: 'SymbolsRoundedSmall' with: #( 'MaterialIcons-Core' 'MaterialSymbols-Rounded' );
			group: 'SymbolsRounded' with: #( 'SymbolsRoundedSmall' 'MaterialSymbols-Rounded-192' );
			group: 'SymbolsRoundedFilled' with: #( 'MaterialSymbols-Rounded-Filled' 'MaterialSymbols-Rounded-Filled-192' );
			group: 'ThemePack' with: #( 'MaterialIcons-ThemePack' );
			group: 'SymbolsThemePack' with: #( 'MaterialSymbols-ThemePack' );
			group: 'IconsTests' with: #( 'MaterialIcons-Tests' );
			group: 'SymbolsTests' with: #( 'MaterialSymbols-Tests' );
			group: 'SymbolsProtocols' with: #( 'SymbolsRoundedSmall' 'MaterialSymbols-Protocols' 'MaterialSymbols-Protocols-Calypso' );
			group: 'SymbolsProtocolsTests' with: #( 'MaterialSymbols-Protocols-Tests' );
			group: 'Tests' with: #( 'IconsTests' 'SymbolsTests' );
			group: 'default' with: #( 'SymbolsRoundedSmall' 'SymbolsThemePack' 'SymbolsProtocols' 'SymbolsTests' 'SymbolsProtocolsTests' );
			group: 'Full' with: #( 'IconsRounded' 'SymbolsRounded' 'SymbolsRoundedFilled' 'ThemePack' 'SymbolsThemePack' 'SymbolsProtocols' 'Tests' 'SymbolsProtocolsTests' ) ]
]

{ #category : 'doits' }
BaselineOfMaterialIcons >> materialIconsPostLoad [
	"A newer version of the icons replaces the index and the Forms of the older one (the UI is left as it is)"

	(Smalltalk globals at: #MaterialIcons ifAbsent: [ nil ]) ifNotNil: [ :class |
		class reset ]
]
