"
I load Material Icons Rounded (fonts.google.com/icons, icon.set=Material+Icons, icon.style=Rounded) into Pharo 12 to 15:

- `MaterialIcons-Core` and `MaterialIcons-Rounded` (group `Core`): `MaterialIcons rounded`, the 2127 icons by their Material names, as Forms and FormSets at 16, 24 and 32 pixels, in any colour; their categories, codepoints and tags. `MaterialIcons-Rounded` is generated by scripts/generate.py;
- `MaterialIcons-ThemePack` (group `ThemePack`): `MaterialThemeIcons`, an icon pack of Pharo's UI drawn with them, over the current pack: `MaterialThemeIcons install` and `MaterialThemeIcons uninstall`. Loading it changes nothing in the UI;
- `MaterialIcons-Tests` (group `Tests`): their tests.

```
Metacello new
	baseline: 'MaterialIcons';
	repository: 'github://massimo-nocentini/material-icons.st:master/src';
	load
```

`load: 'Core'` loads the icons alone, `load: #( 'Core' 'ThemePack' )` without the tests.
"
Class {
	#name : 'BaselineOfMaterialIcons',
	#superclass : 'BaselineOf',
	#category : 'BaselineOfMaterialIcons',
	#package : 'BaselineOfMaterialIcons'
}

{ #category : 'baselines' }
BaselineOfMaterialIcons >> baseline: spec [

	<baseline>
	spec for: #common do: [
		spec
			package: 'MaterialIcons-Core';
			package: 'MaterialIcons-Rounded' with: [
				spec
					requires: #( 'MaterialIcons-Core' );
					postLoadDoIt: #materialIconsPostLoad ];
			package: 'MaterialIcons-ThemePack'
			with: [ spec requires: #( 'MaterialIcons-Rounded' ) ];
			package: 'MaterialIcons-Tests'
			with: [ spec requires: #( 'MaterialIcons-ThemePack' ) ].
		spec
			group: 'Core' with: #( 'MaterialIcons-Core' 'MaterialIcons-Rounded' );
			group: 'ThemePack' with: #( 'MaterialIcons-ThemePack' );
			group: 'Tests' with: #( 'MaterialIcons-Tests' );
			group: 'default' with: #( 'Core' 'ThemePack' 'Tests' ) ]
]

{ #category : 'doits' }
BaselineOfMaterialIcons >> materialIconsPostLoad [
	"A newer version of the icons replaces the index and the Forms of the older one (the UI is left as it is)"

	(Smalltalk globals at: #MaterialIcons ifAbsent: [ nil ]) ifNotNil: [ :class |
		class reset ]
]
